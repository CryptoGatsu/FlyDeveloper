# Copy to .env (never committed). Every value is optional; the fly degrades
# to phantom brain / offline mind / dry-run launchpad when something is unset.

# --- mind ------------------------------------------------------------------
ANTHROPIC_API_KEY=
FLY_MIND=claude            # claude | offline
FLY_MODEL=claude-opus-5
FLY_EFFORT=high            # low | medium | high | xhigh | max

# --- brain -----------------------------------------------------------------
FLY_BRAIN=connectome       # connectome (needs data/) | phantom
FLY_BRAIN_T_RUN=0.1        # simulated seconds per perception
#FLY_BRAIN_SEED=42         # fix for reproducible moods

# --- browsing --------------------------------------------------------------
FLY_MAX_PAGES=6
FLY_HTTP_TIMEOUT=20

# --- Pons launchpad on Robinhood Chain --------------------------------------
FLY_RPC_URL=https://rpc.mainnet.chain.robinhood.com
FLY_CHAIN_ID=4663
FLY_PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
FLY_LAUNCH_CONFIG_ID=0
FLY_WALLET_PRIVATE_KEY=    # a dedicated hot wallet holding only what you are willing to lose
FLY_LIVE_LAUNCH=0          # 1 arms real transactions (also pass --live)
FLY_MAX_LAUNCHES_PER_DAY=1
FLY_MAX_LAUNCH_FEE_ETH=0.01
FLY_INITIAL_BUY_ETH=0
FLY_MAX_INITIAL_BUY_ETH=0.01
FLY_CREATOR_TAX_BPS=0
FLY_BUYBACK_ENABLED=1
FLY_CREATOR_FEE_RECIPIENT=
FLY_WEBSITE=https://github.com/CryptoGatsu/FlyDeveloper
FLY_GENESIS_NAME=The Fly Dev   # the fly's own coin, launched first (empty disables)
FLY_GENESIS_SYMBOL=FLYDEV
FLY_TWITTER=
FLY_TELEGRAM=

# --- meme hosting (needed for a real launch: the logo is a URL on chain) ---
FLY_IMAGE_HOST=none        # none | pinata | github
PINATA_JWT=                # Pinata API key JWT (Files: write scope)
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs   # better: https://<name>.mypinata.cloud/ipfs
FLY_GITHUB_TOKEN=
FLY_GITHUB_REPO=           # owner/name, e.g. CryptoGatsu/FlyDeveloper
FLY_GITHUB_BRANCH=main
FLY_GITHUB_DIR=memes

# --- pacing ----------------------------------------------------------------
FLY_TICK_INTERVAL_SEC=1800
