# Copy to .env (never committed). Every value is optional; the fly degrades
# to phantom brain / offline mind / dry-run launchpad when something is unset.

# --- mind ------------------------------------------------------------------
ANTHROPIC_API_KEY=
FLY_MIND=claude            # claude | offline
FLY_MODEL=claude-opus-5
FLY_EFFORT=high            # low | medium | high | xhigh | max

# --- brain -----------------------------------------------------------------
FLY_BRAIN=connectome       # connectome (needs data/) | phantom
FLY_BRAIN_T_RUN=0.1        # simulated seconds per perception
#FLY_BRAIN_SEED=42         # fix for reproducible moods

# --- browsing --------------------------------------------------------------
FLY_MAX_PAGES=6
FLY_HTTP_TIMEOUT=20

# --- Pons launchpad on Robinhood Chain --------------------------------------
FLY_RPC_URL=https://rpc.mainnet.chain.robinhood.com
FLY_CHAIN_ID=4663
FLY_PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
FLY_LAUNCH_CONFIG_ID=0
FLY_PAIR_TOKEN=0x2e0847E8910a9732eB3fb1bb4b70a580ADAD4FE3   # quote asset for every coin: GOOGL stock token (or ETH for native)
FLY_PAIR_SYMBOL=GOOGL      # the fly checks the token calls itself this on chain before a live launch
FLY_WALLET_PRIVATE_KEY=    # a dedicated hot wallet holding only what you are willing to lose
FLY_LIVE_LAUNCH=0          # 1 arms real transactions (also pass --live)
FLY_MAX_LAUNCHES_PER_DAY=1
FLY_MAX_LAUNCH_FEE_ETH=0.01
FLY_INITIAL_BUY_ETH=0
FLY_MAX_INITIAL_BUY_ETH=0.01
FLY_CREATOR_TAX_BPS=0
FLY_BUYBACK_ENABLED=1
FLY_CREATOR_FEE_RECIPIENT=
FLY_WEBSITE=https://flydev.tech
FLY_GENESIS_NAME=The Fly Dev   # the fly's own coin, launched first (empty disables)
FLY_GENESIS_SYMBOL=FLYDEV
FLY_GENESIS_BUYBACK=0          # genesis creator fees stay in the wallet (fund the project)
FLY_COIN_FEE_MODE=buyback      # other coins: buyback (buy back + lock) | wallet (fees to the wallet)
FLY_TWITTER=https://x.com/TheFlyDev_
FLY_TELEGRAM=

# --- meme hosting (needed for a real launch: the logo is a URL on chain) ---
FLY_IMAGE_HOST=none        # none | pinata | github
PINATA_JWT=                # Pinata API key JWT (Files: write scope)
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs   # better: https://<name>.mypinata.cloud/ipfs
FLY_GITHUB_TOKEN=
FLY_GITHUB_REPO=           # owner/name, e.g. CryptoGatsu/FlyDeveloper
FLY_GITHUB_BRANCH=main
FLY_GITHUB_DIR=memes

# --- X (Twitter) posting ---------------------------------------------------
# From developer.x.com: an app with Read+Write, its consumer key/secret, and
# the @TheFlyDev_ account's access token/secret. Without them posts are drafts.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
FLY_X_POST=0               # 1 sends posts (also pass --live); 0 keeps them as drafts
FLY_X_MAX_POSTS_PER_DAY=30   # own posts per day; replies do not count
FLY_X_HYPE_EVERY_HOURS=2   # unprompted $FLYDEV posts at most this often
FLY_X_MAX_REPLIES_PER_DAY=60
FLY_X_MAX_REPLIES_PER_ACCOUNT_PER_DAY=2   # promo bots and 'DM me' pitches are ignored outright
FLY_X_MENTIONS_EVERY_SEC=180  # while resting, check for @mentions this often and reply

# --- chat on flydev.tech/ask: these go on VERCEL, not here ------------------
# ANTHROPIC_API_KEY, FLY_CHAT_SECRET (long random string), optional FLY_CHAT_MODEL,
# FLY_RPC_URL, FLY_FREE_TURNS=5, FLY_BURN_AMOUNT=5000, FLY_BURN_TURNS=10,
# FLY_DAILY_TURN_BUDGET=1500, UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN

# --- fly cam (live view of what it is browsing) -----------------------------
FLY_SITE_URL=https://flydev.tech
FLY_CAM_SECRET=            # any long random string; set the SAME value on Vercel as FLY_CAM_SECRET

# --- website ---------------------------------------------------------------
FLY_PUBLISH=site           # none | site (export site/data/state.json) | git (export + commit + push)
FLY_SITE_DOMAIN=flydev.tech   # written to site/CNAME for GitHub Pages
#FLY_CHROME=                  # path to Chrome/Chromium for visual QA (auto-detected on macOS/Linux)

# --- pacing ----------------------------------------------------------------
FLY_MAX_REST_SEC=300        # the fly never rests longer than this between actions
FLY_TICK_INTERVAL_SEC=0    # 0 = free will (the fly decides how long to rest); or seconds between actions
FLY_MAX_ACTIONS_PER_DAY=200 # cost guard: past this it mostly rests until tomorrow
